# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build output
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
/services/media-engine/**/bin/
/services/media-engine/**/obj/
/services/media-engine/publish/

# Runtime data never belongs in the repository: accounts, settings, credentials, caches, logs.
# (Notflix keeps them in the data folder, %ProgramData%\NotflixDebrid by default.)
/.data/
/data/
/.cache/
/.run/
/logs/
/.notflix-data-dir
*.pem
*.key
secrets.json
engine-secret
setup-code.txt
users.json

# env files - never commit secrets (Notflix does not need a .env file)
.env
.env.*

# tests and generated media
/coverage
/test-media/
/test-results/
/playwright-report/
*.tmp.mjs

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# editors / OS
.vscode/
.idea/
.cursor/
.DS_Store
Thumbs.db
